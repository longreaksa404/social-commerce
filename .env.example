# Copy to .env in the repo root: cp .env.example .env
# One file for local dev, read by docker-compose, the backend, and Vite.
# In production these are set in the Render / Vercel dashboards instead.

# Local Postgres (docker-compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=social_commerce

# Backend
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/social_commerce
CORS_ORIGINS=["http://localhost:5173"]
# Leave empty locally; set in Render to turn on error tracking.
SENTRY_DSN=
# Signs login tokens. Any random string of 32+ characters; Render generates its own.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Cloudflare R2 for product images; uploads are disabled until all five are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Telegram bot for seller order alerts; off until the first three are set.
# Create the bot with @BotFather in Telegram. Use a separate test bot locally,
# answered by `python -m app.telegram_poll` (from backend/) beside uvicorn.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any random string of letters, numbers, _ and -.
TELEGRAM_WEBHOOK_SECRET=
# This API's public https URL. When set, the webhook is registered at startup,
# so leave it empty locally (a laptop can't receive Telegram's webhook calls).
PUBLIC_API_URL=
# The web app's public https URL, for the "Open order" button in alerts.
PUBLIC_APP_URL=

# "Continue with Google": the OAuth client ID (type "Web application") from
# Google Cloud Console → APIs & Services → Credentials. Not a secret. Put
# the same value in VITE_GOOGLE_CLIENT_ID below. Empty turns Google off.
GOOGLE_CLIENT_ID=
# "Continue with Facebook": the Meta app's ID and secret (developers.facebook.com
# → your app → App settings → Basic). Valid OAuth redirect URI:
# https://order.oaksolve.com/auth/facebook/callback (and http://localhost:5173/...
# locally). The ID also goes in VITE_FACEBOOK_APP_ID. Off unless both are set.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# "Continue with TikTok": the TikTok app's client key and secret
# (developers.tiktok.com → your app → Login Kit). Redirect URI (https only, so
# not localhost): https://order.oaksolve.com/auth/tiktok/callback. The key
# also goes in VITE_TIKTOK_CLIENT_KEY. Off unless both are set.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Frontend (only VITE_-prefixed variables are exposed to the browser)
VITE_API_URL=http://localhost:8000
# Leave empty locally; set in Vercel to turn on error tracking.
VITE_SENTRY_DSN=
# Oak Order's own Telegram username (no @), for sellers' "Message support"
# links in Settings and on the login page. Empty hides them.
VITE_SUPPORT_TELEGRAM=
# The same Google client ID as GOOGLE_CLIENT_ID above. Empty hides the
# "Continue with Google" buttons.
VITE_GOOGLE_CLIENT_ID=
# The same public IDs as FACEBOOK_APP_ID and TIKTOK_CLIENT_KEY above (never the
# secrets). Empty hides that "Continue with ..." button.
VITE_FACEBOOK_APP_ID=
VITE_TIKTOK_CLIENT_KEY=
