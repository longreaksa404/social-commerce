# Copy to .env in the repo root: cp .env.example .env
# One file for local dev, read by docker-compose, the backend, and Vite.
# In production these are set in the Render / Vercel dashboards instead.

# Local Postgres (docker-compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=social_commerce

# Backend
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/social_commerce
CORS_ORIGINS=["http://localhost:5173"]
# Leave empty locally; set in Render to turn on error tracking.
SENTRY_DSN=
# A share of requests whose speed Sentry records, 0 to 1 (e.g. 0.05); 0 or
# left out: errors only, inside the free quota. The admin's System page links it.
SENTRY_TRACES_SAMPLE_RATE=0
# Signs login tokens. Any random string of 32+ characters; Render generates its own.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Cloudflare R2 for product images; uploads are disabled until all five are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Telegram bot for seller order alerts; off until the first three are set.
# Create the bot with @BotFather in Telegram. Use a separate test bot locally,
# answered by `python -m app.telegram_poll` (from backend/) beside uvicorn.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any random string of letters, numbers, _ and -.
TELEGRAM_WEBHOOK_SECRET=
# This API's public https URL. When set, the webhook is registered at startup,
# so leave it empty locally (a laptop can't receive Telegram's webhook calls).
PUBLIC_API_URL=
# The web app's public https URL, for the "Open order" button in alerts.
PUBLIC_APP_URL=

# "Continue with Google": the OAuth client ID (type "Web application") from
# Google Cloud Console → APIs & Services → Credentials. Not a secret. Put
# the same value in VITE_GOOGLE_CLIENT_ID below. Empty turns Google off.
GOOGLE_CLIENT_ID=
# "Continue with Facebook": the Meta app's ID and secret (developers.facebook.com
# → your app → App settings → Basic). Valid OAuth redirect URI:
# https://order.oaksolve.com/auth/facebook/callback (and http://localhost:5173/...
# locally). The ID also goes in VITE_FACEBOOK_APP_ID. Off unless both are set.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# How sellers pay Oak Order by hand (Settings → Plan, with the shop's code).
# Oak's Bakong account ID for a KHQR (e.g. oaksolutions@aclb, from your bank
# app) and the name it shows (English letters, at most 25), and/or a bank
# account. Without either, Settings → Plan says to message Oak Order.
OAK_KHQR_ACCOUNT=
OAK_KHQR_NAME=OAK ORDER
# ABA gives customers no Bakong ID of their own: use ABA's
# (abaakhppxxx@abaa) above, and your account number and "ABA Bank" here, as
# in the text of your ABA app's own QR.
OAK_KHQR_ACCOUNT_INFO=
OAK_KHQR_BANK=
OAK_BANK_NAME=
OAK_BANK_ACCOUNT_NAME=
OAK_BANK_ACCOUNT_NUMBER=
# Any long random string. cron-job.org sends it as X-Cron-Secret on the
# daily run (POST /api/v1/billing/run: payment reminders) and the hourly one
# (POST /api/v1/reminders/run: customers' unpaid orders). Empty turns both off.
BILLING_CRON_SECRET=
# Your own login phone number(s), comma-separated: the admin page, and
# "I've paid" alerts to your shop's Telegram chat.
ADMIN_PHONES=
# Riel to the dollar: a shop switching currency has its prices, fees and
# discounts converted at this rate; 4100 if left out. Only the default since
# 2026-10-30: once a rate is saved in the admin (Settings), that one is used.
KHR_PER_USD=4100

# Frontend (only VITE_-prefixed variables are exposed to the browser)
VITE_API_URL=http://localhost:8000
# Leave empty locally; set in Vercel to turn on error tracking.
VITE_SENTRY_DSN=
# Oak Order's own Telegram username (no @), for sellers' "Message support"
# links in Settings and on the login page. Empty hides them.
VITE_SUPPORT_TELEGRAM=
# The same Google client ID as GOOGLE_CLIENT_ID above. Empty hides the
# "Continue with Google" buttons.
VITE_GOOGLE_CLIENT_ID=
# The same public ID as FACEBOOK_APP_ID above (never the secret). Empty
# hides the "Continue with Facebook" buttons.
VITE_FACEBOOK_APP_ID=

# Marketing pictures (backend/marketing/shots.py, on your laptop only): the
# live demo shop to copy (order.oaksolve.com/shop/<code>), and the KHQR its
# customers pay, which isn't public: your Bakong ID, and with ABA's shared
# ID (abaakhppxxx@abaa) the ABA account number in your QR (from a "dual"
# QR, the dollar one for a dollar shop). Without them the KHQR pictures are
# skipped.
DEMO_SHOP_SLUG=
DEMO_BAKONG_ID=
DEMO_KHQR_ACCOUNT=
