# Copy to .env in the repo root: cp .env.example .env
# One file for local dev, read by docker-compose, the backend, and Vite.
# In production these are set in the Render / Vercel dashboards instead.

# Local Postgres (docker-compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=social_commerce

# Backend
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/social_commerce
CORS_ORIGINS=["http://localhost:5173"]
# Leave empty locally; set in Render to turn on error tracking.
SENTRY_DSN=

# Frontend (only VITE_-prefixed variables are exposed to the browser)
VITE_API_URL=http://localhost:8000
