# Copy to .env in the repo root: cp .env.example .env
# One file for local dev, read by docker-compose, the backend, and Vite.
# In production these are set in the Render / Vercel dashboards instead.

# Local Postgres (docker-compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=social_commerce

# Backend
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/social_commerce
CORS_ORIGINS=["http://localhost:5173"]
# Leave empty locally; set in Render to turn on error tracking.
SENTRY_DSN=
# Signs login tokens. Any random string of 32+ characters; Render generates its own.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Cloudflare R2 for product images; uploads are disabled until all five are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Telegram bot for seller order alerts; off until the first three are set.
# Create the bot with @BotFather in Telegram. Use a separate test bot locally.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any random string of letters, numbers, _ and -.
TELEGRAM_WEBHOOK_SECRET=
# This API's public https URL. When set, the webhook is registered at startup,
# so leave it empty locally (a laptop can't receive Telegram's webhook calls).
PUBLIC_API_URL=
# The web app's public https URL, for the "Open order" button in alerts.
PUBLIC_APP_URL=

# Frontend (only VITE_-prefixed variables are exposed to the browser)
VITE_API_URL=http://localhost:8000
# Leave empty locally; set in Vercel to turn on error tracking.
VITE_SENTRY_DSN=
